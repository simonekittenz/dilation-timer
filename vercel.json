{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"redirects": [
		{
			"source": "/downloads/Dilation-timer.apk",
			"destination": "https://github.com/simonekittenz/dilation-timer/releases/latest/download/Dilation-timer.apk",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/200.html"
		}
	],
	"headers": [
		{
			"source": "/release.json",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Cache-Control",
					"value": "no-cache, max-age=0, must-revalidate"
				}
			]
		}
	]
}
